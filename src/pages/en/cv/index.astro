---
import '../../../styles/cv.css';
import { getProfile, getProjects, getUi } from '../../../i18n/content';
import { computeSkills, computeStats, groupSkillsByTier, parseFeaturedName, tagValue } from '../../../i18n/skills';
import { site } from '../../../config';
import { ROUTES } from '../../../i18n/routes';

const lang = 'en' as const;
const profile = getProfile(lang);
const projects = getProjects(lang);
const ui = getUi(lang);

const collapse = (text: string) => text.replace(/\s+/g, ' ').trim();
const stripProtocol = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

const nameParts = profile.nom.trim().split(/\s+/);
const lastname = nameParts.pop()!;
const firstname = nameParts.join(' ');

const skills = groupSkillsByTier(
  computeSkills([...profile.formation, ...profile.parcours], projects as { tags: string[] }[], ui.skillCategories),
  ui.skillTiers
);
const metrics = (profile as { stats_cv?: { valeur: string; label: string }[] }).stats_cv ?? computeStats(profile, 'years');
const formation = profile.formation
  .filter((f: { cv?: boolean }) => f.cv !== false)
  .map((f: { titre: string; lieu: string; periode: string; description?: string }) => ({
    titre: f.titre,
    meta: `${f.lieu} · ${f.periode}`,
    description: f.description ? collapse(f.description) : '',
  }));

interface ParcoursEntry {
  titre: string;
  periode: string;
  lieu: string;
  description: string;
  competences?: string[];
  cv?: boolean;
  cv_detail?: 'full' | 'oneline' | 'grouped';
  cv_titre?: string;
  cv_description?: string;
  cv_bullets?: string[];
  cv_stack?: string[];
  cv_complement?: string;
  cv_links?: string[];
}

const toRow = (entry: ParcoursEntry) => ({
  role: entry.cv_titre ?? entry.titre,
  dates: entry.periode,
  org: entry.lieu,
  complement: entry.cv_complement ?? '',
});

const projectBySlug = new Map((projects as { slug: string; lien?: string }[]).map((p) => [p.slug, p]));
const resolveProjectLink = (slug: string) => {
  const p = projectBySlug.get(slug);
  return p ? stripProtocol(p.lien || `${site.social.github}/${slug}`) : null;
};

const visibleParcours = (profile.parcours as ParcoursEntry[]).filter((entry) => entry.cv !== false);

const experiences = visibleParcours
  .filter((entry) => entry.cv_detail !== 'grouped')
  .map((entry) => {
    const detail = entry.cv_detail ?? 'full';
    return {
      ...toRow(entry),
      detail,
      bullets: entry.cv_bullets ?? null,
      bullet: collapse(entry.cv_description ?? entry.description),
      links: (entry.cv_links ?? []).map(resolveProjectLink),
      stack:
        detail === 'full'
          ? (
              entry.cv_stack ??
              (entry.competences ?? []).map(tagValue).filter((value) => value !== 'Freelancing')
            ).join(', ')
          : '',
    };
  });

const earlierExperiences = visibleParcours.filter((entry) => entry.cv_detail === 'grouped').map(toRow);

const mobiliteParts = profile.mobilite.split(/,\s*On-site portion\s*:\s*/);
const workMode = mobiliteParts[0];
const onSiteLocation = mobiliteParts.length > 1 ? mobiliteParts[1] : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Résumé — {profile.nom}</title>
  </head>
  <body>
    <div class="toolbar no-print">
      <a href={ROUTES.about[lang]}>{ui.cv.backButton}</a>
      <button onclick="window.print()">{ui.cv.printButton}</button>
    </div>

    <div class="page">
      <div class="masthead">
        <div class="id">
          <h1 class="name">{firstname} <span class="lastname">{lastname}</span></h1>
          <div class="role">{profile.titre}</div>
        </div>
        <div class="location">
          {onSiteLocation && <span class="loc-line">{onSiteLocation}</span>}
          <span class="loc-line">{workMode}</span>
          <span class="loc-line">{profile.disponibilite}</span>
        </div>
        <div class="contact">
          {import.meta.env.DEV ? (
            <span class="c-line">{site.contactEmail}</span>
          ) : (
            <span class="c-line"><canvas class="contact-canvas" data-b64={Buffer.from(site.contactEmail).toString('base64')}></canvas></span>
          )}
          {site.contactPhone && (
            import.meta.env.DEV ? (
              <span class="c-line">{site.contactPhone}</span>
            ) : (
              <span class="c-line"><canvas class="contact-canvas" data-b64={Buffer.from(site.contactPhone).toString('base64')}></canvas></span>
            )
          )}
          {site.social.linkedin && <span class="c-line">{stripProtocol(site.social.linkedin)}</span>}
          {site.social.github && <span class="c-line">{stripProtocol(site.social.github)}</span>}
          <span class="c-line">{stripProtocol(site.url)}</span>
        </div>
      </div>

      <div class="metrics">
        {metrics.map((m) => (
          <div class="metric">
            <div class="val">{m.valeur}</div>
            <div class="lab">{m.label}</div>
          </div>
        ))}
      </div>

      <div class="body">
        <aside class="rail">
          <div class="sec">{ui.cv.skillsTitle}</div>
          {skills.filter((tier) => tier.items.length > 0).map((tier, index) => (
            <div class="skill-group">
              <div class="skill-label">{tier.nom}</div>
              <div class="chips">
                {tier.items.map((item) => (
                  <span class:list={['chip', { key: index === 0 }]}>{item.value}</span>
                ))}
              </div>
            </div>
          ))}

          <div class="sec">{ui.cv.projectsTitle}</div>
          {(projects as { slug: string; nom: string; description_courte: string; cv_description_courte?: string; cv?: boolean; lien?: string }[])
            .filter((p) => p.cv)
            .map((p) => (
              <div class="proj-item">
                <div class="proj-name">{parseFeaturedName(p.nom).value}</div>
                <div class="proj-desc">{p.cv_description_courte ?? p.description_courte}</div>
                <div class="proj-link">{stripProtocol(p.lien || `${site.social.github}/${p.slug}`)}</div>
              </div>
            ))}

          <div class="sec">{ui.cv.communityTitle}</div>
          {(profile.engagements as { titre: string; description: string }[]).map((e) => (
            <div class="proj-item">
              <div class="proj-name">{e.titre}</div>
              <div class="proj-desc">{e.description}</div>
            </div>
          ))}

          <div class="sec">{ui.cv.formationTitle}</div>
          {formation.map((f: { titre: string; meta: string; description: string }) => (
            <div class="edu-item">
              <div class="edu-title">{f.titre}</div>
              <div class="edu-meta">{f.meta}</div>
              {f.description && <div class="edu-desc">{f.description}</div>}
            </div>
          ))}

          <div class="sec">{ui.cv.languagesTitle}</div>
          {profile.langues.map((l: { nom: string; niveau: string }) => (
            <div class="lang-row">
              <span class="lang-name">{l.nom}</span>
              <span class="lang-lvl">{l.niveau}</span>
            </div>
          ))}

          <div class="sec">{ui.cv.interestsTitle}</div>
          <div class="interests">{profile.interets}</div>
        </aside>

        <main class="main">
          <div class="sec">{ui.cv.profileTitle}</div>
          <p class="profile">{(profile.cv_summary ?? profile.bio).trim()}</p>

          <div class="sec" style="margin-top:13px;">{ui.cv.experienceTitle}</div>
          {experiences.map((xp: { role: string; dates: string; org: string; complement: string; detail: string; bullets: string[] | null; bullet: string; stack: string; links: (string | null)[] }) => (
            xp.detail === 'oneline' ? (
              <div class="xp-oneline">
                <div class="xp-oneline-head">
                  <div class="xp-oneline-role">{xp.role}</div>
                  <div class="xp-oneline-dates">{xp.dates}</div>
                </div>
                <div class="xp-oneline-org">{xp.org}{xp.complement && ` — ${xp.complement}`}</div>
              </div>
            ) : (
              <div class="xp">
                <div class="xp-head">
                  <div class="xp-role">{xp.role}</div>
                  <div class="xp-dates">{xp.dates}</div>
                </div>
                <div class="xp-org">{xp.org}{xp.complement && ` — ${xp.complement}`}</div>
                <ul class="bullets">
                  {xp.bullets ? xp.bullets.map((b, i) => (
                    <li>
                      {b}
                      {xp.links[i] && <div class="xp-links">{xp.links[i]}</div>}
                    </li>
                  )) : <li>{xp.bullet}</li>}
                </ul>
                {xp.stack && (
                  <div class="stack">
                    <span class="k">{ui.cv.stackLabel} ·</span> {xp.stack}
                  </div>
                )}
              </div>
            )
          ))}

          {earlierExperiences.length > 0 && (
            <>
              <div class="sec" style="margin-top:13px;">{ui.cv.earlierExperienceTitle}</div>
              {earlierExperiences.map((xp: { role: string; dates: string; org: string; complement: string }) => (
                <div class="xp-compact">
                  <span class="xp-compact-role">{xp.role}</span>
                  <span class="xp-compact-org">— {xp.org}{xp.complement && ` · ${xp.complement}`}</span>
                  <span class="xp-compact-dates">{xp.dates}</span>
                </div>
              ))}
            </>
          )}
        </main>
      </div>
    </div>

    <script>
      // Email / phone drawn as pixels in a <canvas> instead of HTML text, so they
      // can't be picked up by scrapers that only read the DOM/HTML. Rendered at a
      // fixed internal resolution (well above devicePixelRatio) to stay sharp even
      // when printed/exported to PDF, using the same font/size/color as the rest
      // of the contact block (cv.css → .contact) for visual consistency.
      function renderContactCanvases() {
        const fontSize = 8.2;
        const fontWeight = 500;
        const scale = 4;
        const font = `${fontWeight} ${fontSize}px 'JetBrains Mono', monospace`;
        const textColor = getComputedStyle(document.documentElement).getPropertyValue('--muted').trim() || '#667179';
        document.querySelectorAll<HTMLCanvasElement>('canvas.contact-canvas').forEach((canvas) => {
          const encoded = canvas.dataset.b64;
          if (!encoded) return;
          const text = atob(encoded);
          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          ctx.font = font;
          const width = Math.ceil(ctx.measureText(text).width) + 2;
          const height = Math.ceil(fontSize * 1.4);
          canvas.width = width * scale;
          canvas.height = height * scale;
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          ctx.scale(scale, scale);
          ctx.font = font;
          ctx.fillStyle = textColor;
          ctx.textBaseline = 'top';
          ctx.fillText(text, 0, 0);
        });
      }
      document.fonts ? document.fonts.ready.then(renderContactCanvases) : renderContactCanvases();
    </script>
  </body>
</html>
